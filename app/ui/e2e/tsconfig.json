{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "useDefineForClassFields": true
  },
  "include": ["./**/*.ts", "../playwright.config.ts"]
}
