{
  "homeRoute": "/dashboard",
  "documentRoute": "/documents/:id",
  "access": {
    "minQueryLength": 2,
    "searchDebounceMs": 300,
    "grantPathSeparator": " > "
  },
  "cleanup": {
    "defaultSegment": "duplicates",
    "segments": ["duplicates", "expiry", "anomalies", "exposure"],
    "draftTemplates": {
      "exact": "exact-duplicates",
      "near": "near-duplicates",
      "expired": "expired-documents",
      "reviewOverdue": "requires-review"
    }
  },
  "notifications": {
    "defaultStatus": "draft",
    "statuses": ["draft", "approved", "dryRunRecorded", "sent", "failed"]
  }
}
