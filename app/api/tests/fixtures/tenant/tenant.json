      {
        "key": "fap",
        "kind": "file",
        "path": "Failure Analysis Procedure.docx",
        "unique": false,
        "modified": "2025-01-20T09:00:00Z",
        "size": 5120,
        "content": {"kind": "docx", "paragraphs": ["Failure analysis procedure for ApexDrive X500. Step 1: isolate the unit within 45 minutes of the alarm. Step 2: capture the thermal log for at least 1200 seconds before power down. Step 3: record the serial number, firmware revision and operator initials on form QA-7. Step 4: escalate any repeat failure above 3 units per shift to the quality lead. The approved review interval for this procedure is twelve months and all deviations must be logged against the controlling record."]},
        "owner": "alice",
        "links": [
          {"id": "perm-org-1", "roles": ["read"], "link": {"scope": "organization", "type": "view", "webUrl": "https://contoso.sharepoint.com/:b:/s/knowledge/SECRET-LINK-TOKEN"}}
        ],
        "gov": {"ArtifactId": "TK-0001", "LifecycleStatus": "Published", "Authoritative": true, "ReviewDate": "2027-01-15T00:00:00Z", "EffectiveDate": "2025-01-15T00:00:00Z", "DocumentType": "Procedure", "ProductFamily": "ApexDrive X500", "ProcessArea": "Failure Analysis", "Sensitivity": "General", "AIReady": true, "TrustScore": 92, "DataQualityStatus": "Good", "ConflictStatus": "Conflicting Authoritative", "ConflictWith": "Failure Analysis Limits (2026).docx", "KnowledgeCategory": "Quality", "SourceSystem": "SharePoint Online", "BusinessUnit": "Quality"}
